# Загальні налаштування
TZ=Europe/Kyiv
PUID=1000
PGID=1000

# Версії образів
OPENHAB_VERSION=4.2.2
INFLUXDB_VERSION=2.7
GRAFANA_VERSION=11.2.0
MOSQUITTO_VERSION=2.0.18

# Порти
OPENHAB_HTTP_PORT=8080
OPENHAB_HTTPS_PORT=8443
GRAFANA_PORT=3000
INFLUXDB_PORT=8086
MQTT_PORT=1883

# InfluxDB Credentials
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=ChangeMeStrongPassword123!
INFLUXDB_ORG=smarthome
INFLUXDB_BUCKET=openhab_data
INFLUXDB_TOKEN=my-super-secret-auth-token

# Grafana Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeMeGrafana123!
